{
  "name": "fantasy-football-power-rankings",
  "version": "1.0.0",
  "description": "Advanced Fantasy Football Power Rankings Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm config set cache /tmp/.npm-cache && rm -rf node_modules/.vite && vite build",
    "preview": "vite preview",
    "start": "vite preview --port $PORT --host 0.0.0.0",
    "server": "node server.js",
    "server:dev": "NODE_ENV=development node server.js",
    "server:prod": "NODE_ENV=production node server.js",
    "analytics:setup": "node scripts/setup-analytics.js",
    "analytics:sync": "node -e \"import('./services/ffAnalyticsService.js').then(m => new m.FFAnalyticsService().updateAllPlayerAnalytics())\"",
    "analytics:sync-week": "node scripts/sync-week.js",
    "analytics:test-server": "node scripts/test-server.js",
    "analytics:health-check": "node scripts/analytics-health-check.js",
    "analytics:deploy": "bash scripts/deploy-analytics.sh",
    "analytics:migrate-db": "node scripts/migrate-analytics-db.js",
    "analytics:install-r": "Rscript scripts/install-r-dependencies.R",
    "analytics:test-r": "Rscript scripts/ffanalytics/test_environment.R",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "validate-build": "node scripts/validate-build.js",
    "kill-preview": "npx kill-port 4173 || pkill -f 'vite preview' || echo 'No preview server running'",
    "postbuild": "echo 'Build completed successfully!'",
    "db:setup": "echo 'Run the SQL files in database/ folder in your Supabase SQL editor'",
    "db:reset": "echo 'Reset database by running schema.sql then functions.sql in Supabase'",
    "sync-playoff-games": "node scripts/syncPlayoffGames.js",
    "automation:test": "node scripts/weeklyDataUpdate.js test",
    "automation:run": "node scripts/weeklyDataUpdate.js full",
    "automation:status": "curl -s http://localhost:3001/api/automation/status | jq",
    "automation:logs": "curl -s http://localhost:3001/api/automation/logs | jq",
    "automation:trigger": "curl -X POST -s http://localhost:3001/api/automation/trigger | jq",
    "ffanalytics-config": "node scripts/ffanalytics-config-cli.js"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@floating-ui/react-dom": "^2.1.6",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.39.0",
    "@tailwindcss/postcss": "^4.1.17",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.344.0",
    "morgan": "^1.10.1",
    "next-themes": "^0.4.6",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.66.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.15.4",
    "slick-carousel": "^1.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0",
    "vaul": "^1.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.5.4",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
