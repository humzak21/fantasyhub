{
  "name": "fantasy-football-power-rankings",
  "version": "1.0.0",
  "description": "Advanced Fantasy Football Power Rankings Application",
  "type": "module",
  "scripts": {
    "prepare": "test -f scripts/setup-git-merge-driver.sh && sh scripts/setup-git-merge-driver.sh || true",
    "dev": "vite",
    "build": "npm config set cache /tmp/.npm-cache && rm -rf node_modules/.vite && vite build",
    "preview": "vite preview",
    "start": "serve -s dist -l ${PORT:-3000}",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "validate-build": "node scripts/validate-build.js",
    "kill-preview": "npx kill-port 4173 || pkill -f 'vite preview' || echo 'No preview server running'",
    "postbuild": "echo 'Build completed successfully!'",
    "db:push": "supabase db push",
    "db:push:dry": "supabase db push --dry-run",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --project-id kvcnijyyfylxfarrlxkv > types/supabase.ts",
    "sync-schedule": "node scripts/sync-schedule.js",
    "sync-week": "node scripts/sync-week.js",
    "check-bundle": "node scripts/check-bundle.js",
    "check-css-tokens": "node scripts/check-css-tokens.js",
    "test:e2e": "playwright test",
    "capture-screens": "node scripts/capture-screens.mjs",
    "check-mobile": "./scripts/check-mobile-conventions.sh"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "serve": "^14.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.39",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.5.4",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
