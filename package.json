{
  "name": "fantasy-football-power-rankings",
  "version": "1.0.0",
  "description": "Advanced Fantasy Football Power Rankings Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm config set cache /tmp/.npm-cache && vite build",
    "preview": "vite preview",
    "start": "vite preview --port $PORT --host 0.0.0.0",
    "server": "node server.js",
    "server:dev": "NODE_ENV=development node server.js",
    "server:prod": "NODE_ENV=production node server.js",
    "analytics:setup": "node scripts/setup-analytics.js",
    "analytics:sync": "node -e \"import('./services/ffAnalyticsService.js').then(m => new m.FFAnalyticsService().updateAllPlayerAnalytics())\"",
    "analytics:sync-week": "node scripts/sync-week.js",
    "analytics:test-server": "node scripts/test-server.js",
    "analytics:health-check": "node scripts/analytics-health-check.js",
    "analytics:deploy": "bash scripts/deploy-analytics.sh",
    "analytics:migrate-db": "node scripts/migrate-analytics-db.js",
    "analytics:install-r": "Rscript scripts/install-r-dependencies.R",
    "analytics:test-r": "Rscript scripts/ffanalytics/test_environment.R",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "postbuild": "echo 'Build completed successfully!'",
    "db:setup": "echo 'Run the SQL files in database/ folder in your Supabase SQL editor'",
    "db:reset": "echo 'Reset database by running schema.sql then functions.sql in Supabase'",
    "ffanalytics-config": "node scripts/ffanalytics-config-cli.js"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@floating-ui/react-dom": "^2.1.6",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.39.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.344.0",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.4",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
