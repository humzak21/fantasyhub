# Environment Configuration
NODE_ENV=development

# App Configuration
VITE_APP_NAME="Fantasy Football Power Rankings"
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Advanced analytics for competitive fantasy football leagues"

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Service Role Key (for server-side operations if needed)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deployment notes:
# - The app deploys as a static bundle; there is no application server.
# - VITE_ prefixed variables are inlined into the browser bundle at build time.
# - Scripts fall back to SUPABASE_URL if VITE_SUPABASE_URL is not found.
# - SUPABASE_SERVICE_ROLE_KEY is needed by scripts/ and the scheduled sync only.
#   Never expose it to the browser.

# Admin Configuration
# Set this to the UUID of your admin user (get from: SELECT id, email FROM auth.users;)
VITE_ADMIN_USER_ID=your-admin-user-uuid

# API Configuration
VITE_API_TIMEOUT=10000

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# Storage Configuration
VITE_LOCAL_STORAGE_KEY=fantasy-football-data
VITE_SESSION_STORAGE_KEY=fantasy-football-session

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true

# Development Configuration
VITE_HOT_RELOAD=true
VITE_SOURCE_MAPS=true

# Production Configuration (the host will override these)
PORT=3000

# ESPN Credentials
# Required for private-league reads: rosters, scores and transactions.
# Get them from a browser logged in to ESPN -> DevTools -> Application ->
# Cookies -> https://espn.com. SWID works with or without its braces;
# config/espn-config.js normalises it either way.
# The scheduled sync (.github/workflows/sync-week.yml) reads these from
# repository secrets, not from this file.
ESPN_S2=your-espn-s2-cookie
ESPN_SWID=your-espn-swid-cookie

# Optional ESPN overrides. Normally unnecessary: the active season row owns
# these (seasons.espn_league_id, seasons.espn_season_year) and the sync reads
# the season first.
# ESPN_LEAGUE_ID=67674700
# ESPN_SEASON_YEAR=2026
