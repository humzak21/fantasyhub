# Environment Configuration
NODE_ENV=development

# App Configuration
VITE_APP_NAME="Fantasy Football Power Rankings"
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Advanced analytics for competitive fantasy football leagues"

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Service Role Key (for server-side operations if needed)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Railway Deployment Notes:
# - Set these as environment variables in Railway dashboard
# - VITE_ prefixed variables are exposed to the browser
# - Scripts will fallback to SUPABASE_URL if VITE_SUPABASE_URL not found
# - For production, ensure SUPABASE_SERVICE_ROLE_KEY is set for admin operations

# Admin Configuration
# Set this to the UUID of your admin user (get from: SELECT id, email FROM auth.users;)
VITE_ADMIN_USER_ID=your-admin-user-uuid

# API Configuration
VITE_API_TIMEOUT=10000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# Storage Configuration
VITE_LOCAL_STORAGE_KEY=fantasy-football-data
VITE_SESSION_STORAGE_KEY=fantasy-football-session

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true

# Development Configuration
VITE_HOT_RELOAD=true
VITE_SOURCE_MAPS=true

# Production Configuration (Railway will override these)
PORT=4173
HOST=0.0.0.0

# Automation Configuration
# Enable/disable automation scheduler (true/false)
ENABLE_AUTOMATION=true

# Cron schedule for weekly updates (default: Tuesday at 5 AM)
# Format: "minute hour day_of_month month day_of_week"
# Examples:
#   "0 5 * * 2"  = Tuesday at 5:00 AM
#   "30 6 * * 1" = Monday at 6:30 AM
#   "0 4 * * 0"  = Sunday at 4:00 AM
AUTOMATION_SCHEDULE=0 5 * * 2

# Timezone for automation scheduling
# Use standard timezone names (e.g., America/New_York, America/Los_Angeles, UTC)
AUTOMATION_TIMEZONE=America/New_York

# Frontend Configuration (for CORS)
FRONTEND_URL=https://your-frontend-domain.com
VERCEL_URL=https://your-vercel-deployment.vercel.app

# MovieTracker Backend Configuration
# Server-only variables (do NOT prefix with VITE_)
TMDB_API_KEY=your_tmdb_api_key
TMDB_BASE_URL=https://api.themoviedb.org/3

# MovieTracker Rate Limiting and Uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=10485760